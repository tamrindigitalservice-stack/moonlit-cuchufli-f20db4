rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is an authorized admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection: Only authenticated admins can read their own record or admins can manage
    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Service Requests: Public can create, but cannot read or edit existing requests
    match /serviceRequests/{requestId} {
      allow create: if request.resource.data.customerName is string 
                    && request.resource.data.mobile is string
                    && request.resource.data.serviceName is string;
      allow read, update, delete: if isAdmin();
    }

    // Services: Public can read, only admins can write
    match /services/{serviceId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Announcements: Public can read, only admins can write
    match /announcements/{announcementId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Business Settings: Public can read, only admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}
